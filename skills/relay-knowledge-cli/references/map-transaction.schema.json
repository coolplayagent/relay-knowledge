{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay-knowledge.dev/schemas/map-transaction.v1.json",
  "title": "Knowledge Map transaction",
  "description": "Structural contract; the CLI additionally enforces byte budgets, identity, paths, source bindings and runtime preconditions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "transaction_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "expected_map_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "add"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "kind": {
                "enum": [
                  "repo",
                  "file",
                  "doc",
                  "config",
                  "db",
                  "ci",
                  "runtime",
                  "wiki",
                  "monitoring"
                ]
              },
              "uri": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "source_scope": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "op",
              "id",
              "topic",
              "kind",
              "uri"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "update"
              },
              "change": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "topic": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "enum": [
                          "repo",
                          "file",
                          "doc",
                          "config",
                          "db",
                          "ci",
                          "runtime",
                          "wiki",
                          "monitoring"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "uri": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "source_scope": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 4096
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "description": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 65536
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "required": [
              "op",
              "change"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "remove"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "op",
              "id"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "transaction_id",
    "operations"
  ]
}
