{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authored-evidence-bundle.schema.json",
  "title": "authored-evidence-bundle",
  "$comment": "Runtime also enforces UTF-8 byte budgets, source scopes, confined paths, stable identities and exact span/hash bindings.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "id",
              "kind",
              "label"
            ],
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "relation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "evidence": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            "required": [
              "source",
              "target",
              "relation"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path_base": {
                "enum": [
                  "repository",
                  "catalog"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path_base",
              "path",
              "sha256"
            ]
          },
          "span": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start_byte": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_byte": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "start_byte",
                  "end_byte",
                  "start_line",
                  "end_line"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "interpretation": {
            "enum": [
              "source_statement",
              "author_analysis",
              "hypothesis",
              "user_scope_confirmation",
              "historical_disambiguation"
            ]
          }
        },
        "required": [
          "id",
          "source_scope",
          "artifact",
          "interpretation"
        ],
        "additionalProperties": false
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aliases": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "source_scope",
    "graph",
    "evidence"
  ],
  "additionalProperties": false
}
