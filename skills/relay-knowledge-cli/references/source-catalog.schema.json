{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay-knowledge.dev/schemas/source-catalog.v1.json",
  "title": "Local research capture catalog",
  "description": "Structural contract; the CLI additionally enforces byte budgets, identity, paths, source bindings and runtime preconditions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adapter": {
      "const": "relay-capture-v1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "transport": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "http_status": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 599
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "final_url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "redirects": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "access_error": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": []
              },
              {
                "type": "null"
              }
            ]
          },
          "raw": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path_base": {
                    "enum": [
                      "repository",
                      "catalog"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path_base",
                  "path",
                  "sha256"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "extraction": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "artifact": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path_base": {
                        "enum": [
                          "repository",
                          "catalog"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path_base",
                      "path",
                      "sha256"
                    ]
                  },
                  "raw_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "extractor": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "extractor_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "expected_extractor": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "expected_extractor_version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "artifact",
                  "raw_sha256",
                  "extractor",
                  "extractor_version"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "parent_source": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "references": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path_base": {
                  "enum": [
                    "repository",
                    "catalog"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path_base",
                "path",
                "sha256"
              ]
            }
          },
          "expected_sections": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "declared_coverage": {
            "anyOf": [
              {
                "enum": [
                  "shell",
                  "full_body",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "origin": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "event_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "content_sha256",
                  "reviewer",
                  "origin"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "url"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "adapter",
    "sources"
  ]
}
