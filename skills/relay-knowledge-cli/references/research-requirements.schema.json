{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-requirements.schema.json",
  "title": "research-requirements",
  "$comment": "Runtime also enforces UTF-8 byte budgets, source scopes, confined paths, stable identities and exact span/hash bindings.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path_base": {
                  "enum": [
                    "repository",
                    "catalog"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path_base",
                "path",
                "sha256"
              ]
            }
          },
          "review_claim": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "origin": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "event_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "content_sha256",
                  "reviewer",
                  "origin"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "description",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "requirements"
  ],
  "additionalProperties": false
}
