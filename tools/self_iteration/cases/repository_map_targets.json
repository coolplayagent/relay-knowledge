    {
      "id": "knowledge_history_pages_across_archive_and_recent_boundary",
      "command": [
        "map",
        "history",
        "--type",
        "knowledge",
        "--from",
        "15",
        "--limit",
        "4",
        "--format",
        "json"
      ],
      "objective": "foundational_capability",
      "guardrail": true,
      "json_expect": {
        "path": "knowledge/knowledge-map.yaml",
        "map_type": "knowledge",
        "from_version": 15,
        "through_version": 18,
        "next_from_version": 19,
        "entries": [
          {
            "version": 15,
            "action": "source.update"
          },
          {
            "version": 16,
            "action": "source.add"
          },
          {
            "version": 17,
            "action": "source.add"
          },
          {
            "version": 18,
            "action": "source.update"
          }
        ]
